        local btnToggle = btn("TOGGLE", 350, function()
            local ok, res = processFile(fileEntry, "toggle")
            if ok then
                statusLabel.Text = tostring(res.target)
            else
                statusLabel.Text = "ERR"
                warn(res)
            end
        end)

