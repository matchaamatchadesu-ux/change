-- toggle_portals.lua
-- Roblox executor script
-- Similar mechanism to:
-- https://raw.githubusercontent.com/hatibeehub888-cmd/control/main/script.lua
--
-- This script toggles:
--   replacement_rules[*].enabled
-- in these files:
--   - purple ttk.json
--   - WhitePortal (1).json
--   - Purple Portal.json
--
-- Requirements:
--   - executor supports readfile/writefile/isfile
--   - if using raw_url, URL must return raw JSON text

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local localPlayer = Players.LocalPlayer
local playerGui = localPlayer:FindFirstChild("PlayerGui") or localPlayer:WaitForChild("PlayerGui")

local function hasFileAPI()
    return type(readfile) == "function" and type(writefile) == "function" and type(isfile) == "function"
end

if not hasFileAPI() then
    warn("[TogglePortals] readfile/writefile/isfile is required.")
    return
end

-- =========================
-- 1) FILE LIST
-- =========================
local FILES = {
    {
        name = "purple ttk.json",
        raw_url = nil, -- set if you want remote sync
    },
    {
        name = "WhitePortal (1).json",
        raw_url = nil,
    },
    {
        name = "Purple Portal.json",
        raw_url = nil,
    }
}

