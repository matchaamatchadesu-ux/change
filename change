-- toggle_json_rules_executor.lua
-- Executor-oriented script to toggle replacement_rules[].enabled in local JSON files.
-- Requires: readfile, writefile, isfile (usual exploit file API). Uses HttpService for JSON parsing.

local HttpService = game:GetService("HttpService")

-- ===== CONFIG: ここに対象ファイル名（またはフルパス）を入れてください =====
local FILES = {
    { name = "purple ttk.json" },
    { name = "WhitePortal (1).json" },
    { name = "Purple Portal.json" },
}
-- ==========================================================================

local function has_file_api()
    return (type(readfile) == "function") and (type(writefile) == "function") and (type(isfile) == "function")
end

if not has_file_api() then
    warn("[toggle_json_rules] readfile/writefile/isfile が利用できません。エグゼキューターのファイル API が必要です。")
    return
end

local function backup_file(filename, content)
    local bakname = filename .. ".bak"
    local ok, err = pcall(function() writefile(bakname, content) end)
    return ok, err, bakname
end

local function read_json_file(filename)
    if not isfile(filename) then
        return nil, ("file not found: %s"):format(filename)
    end
    local ok, content = pcall(function() return readfile(filename) end)
    if not ok then return nil, ("readfile failed: %s"):format(tostring(content)) end
    local ok2, obj = pcall(function() return HttpService:JSONDecode(content) end)
    if not ok2 then return nil, ("JSON decode failed: %s"):format(tostring(obj)) end
    return { raw = content, obj = obj }, nil
end

local function write_json_file(filename, obj)
    local ok, encoded = pcall(function() return HttpService:JSONEncode(obj) end)
    if not ok then return false, ("JSON encode failed: %s"):format(tostring(encoded)) end
    local ok2, err2 = pcall(function() writefile(filename, encoded) end)
    if not ok2 then return false, tostring(err2) end
    return true, nil
end

-- Python と同じルール：全 true -> false, 全 false -> true, mixed -> true
local function compute_new_state(rules)
    if type(rules) ~= "table" or #rules == 0 then return true end
    local vals = {}
    for _, r in ipairs(rules) do
        if type(r) == "table" then
            local v = true
            if r.enabled == false then v = false end
            table.insert(vals, v)
        end
    end
    if #vals == 0 then return true end
    local all_true = true
    local any_true = false
    for _, v in ipairs(vals) do
        if v then any_true = true else all_true = false end
    end
    if all_true then return false end
    if not any_true then return true end
    return true -- mixed -> ON
end

local function set_rules_enabled_in_obj(obj, enabled)
    if type(obj) ~= "table" then return 0 end
    local rules = obj.replacement_rules
    if type(rules) ~= "table" then return 0 end
    local changed = 0
    for _, r in ipairs(rules) do
        if type(r) == "table" then
            local before = not (r.enabled == false)
            if before ~= enabled then
                r.enabled = enabled
                changed = changed + 1
            else
                r.enabled = enabled
            end
        end
    end
    return changed
end

local function process_file_toggle(entry, mode)
    local filename = entry.name
    local data, err = read_json_file(filename)
    if not data then
        return false, err
    end
    local orig_raw = data.raw
    local obj = data.obj

    local target_enabled
    if mode == "set_on" then target_enabled = true
    elseif mode == "set_off" then target_enabled = false
    elseif mode == "toggle" then target_enabled = compute_new_state(obj.replacement_rules)
    elseif mode == "preview" then target_enabled = compute_new_state(obj.replacement_rules)
    else return false, "unknown mode"
    end

    local changed = set_rules_enabled_in_obj(obj, target_enabled)

    -- backup
    local okbak, bakerr, bakname = backup_file(filename, orig_raw)
    if not okbak then
        return false, ("backup failed: %s"):format(tostring(bakerr))
    end

    -- write
    local okw, werr = write_json_file(filename, obj)
    if not okw then
        -- try to restore
        pcall(function() writefile(filename, orig_raw) end)
        return false, ("write failed: %s (restored original)"):format(tostring(werr))
    end

    return true, { changed = changed, target = target_enabled, backup = bakname }
end

