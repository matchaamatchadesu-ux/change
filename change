-- per-file UI rows
local buttons = {}
for i, entry in ipairs(FILES) do
    local y = 36 + (i-1) * 40
    local nameLbl = makeText(entry.name, UDim2.new(0, 8, 0, y))
    local statusLbl = Instance.new("TextLabel", frame)
    statusLbl.Size = UDim2.new(0, 80, 0, 20)
    statusLbl.Position = UDim2.new(0, 220, 0, y)
    statusLbl.BackgroundTransparency = 1
    statusLbl.TextColor3 = Color3.fromRGB(200,200,200)
    statusLbl.TextSize = 14
    statusLbl.Font = Enum.Font.Gotham
    statusLbl.Text = isfile(entry.name) and "FOUND" or "MISSING"

    local function makeBtn(label, xpos, callback)
        local btn = Instance.new("TextButton", frame)
        btn.Size = UDim2.new(0, 64, 0, 22)
        btn.Position = UDim2.new(0, xpos, 0, y)
        btn.Text = label
        btn.Font = Enum.Font.Gotham
        btn.TextSize = 13
        btn.BackgroundColor3 = Color3.fromRGB(60,60,60)
        btn.TextColor3 = Color3.fromRGB(240,240,240)
        btn.BorderSizePixel = 0
        btn.AutoButtonColor = true
        btn.MouseButton1Click:Connect(callback)
        return btn
    end

    local btnOn = makeBtn("SET ON", 300, function()
        local ok, res = process_file_toggle(entry, "set_on")
        if ok then
            statusLbl.Text = ("OK: set ON (%d changed)"):format(res.changed)
        else
            statusLbl.Text = "ERR: "..tostring(res)
        end
    end)
    local btnOff = makeBtn("SET OFF", 370, function()
        local ok, res = process_file_toggle(entry, "set_off")
        if ok then
            statusLbl.Text = ("OK: set OFF (%d changed)"):format(res.changed)
        else
            statusLbl.Text = "ERR: "..tostring(res)
        end
    end)
    local btnToggle = makeBtn("TOGGLE", 236, function()
        local ok, res = process_file_toggle(entry, "toggle")
        if ok then
            statusLbl.Text = ("OK: toggle -> %s (%d changed)"):format(tostring(res.target), res.changed)
        else
            statusLbl.Text = "ERR: "..tostring(res)
        end
    end)

    buttons[entry.name] = { on = btnOn, off = btnOff, toggle = btnToggle, status = statusLbl }
end

