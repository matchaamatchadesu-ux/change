-- Precompute entries for faster checks
for _, profile in pairs(profiles) do
    if type(profile.mappings) == "table" then
        profile.entries = {}
        for oldIdStr, newIdStr in pairs(profile.mappings) do
            table.insert(profile.entries, {
                search = tostring(oldIdStr),
                replaceWith = "rbxassetid://" .. tostring(newIdStr),
            })
        end
    end
end

local profileKeys = {"purple_portal"}
local currentProfileIndex = 1
local currentProfile = profiles[profileKeys[currentProfileIndex]]

local candidateProperties = {
    "MeshId",
    "Texture",
    "Image",
    "SoundId",
    "TextureId",
    "BackImage",
}

local function safeGet(instance, prop)
    local ok, value = pcall(function()
        return instance[prop]
    end)
    if ok then
        return value
    end
    return nil
end

local function safeSet(instance, prop, value)
    local ok = pcall(function()
        instance[prop] = value
    end)
    return ok
end

local function replaceOnInstance(instance, profile)
    if not instance or typeof(instance) ~= "Instance" then
        return false
    end

    local changed = false
    local entries = profile.entries
    if not entries then
        return false
    end

    if instance:IsA("MeshPart") or instance:IsA("SpecialMesh") then
        local meshVal = safeGet(instance, "MeshId")
        if type(meshVal) == "string" then
            for _, entry in ipairs(entries) do
                if string.find(meshVal, entry.search, 1, true) then
                    if safeSet(instance, "MeshId", entry.replaceWith) then
                        changed = true
                    end
                    break
                end
            end
        end
    end

    for _, prop in ipairs(candidateProperties) do
        local value = safeGet(instance, prop)
        if type(value) ~= "string" or value == "" then
            -- skip non-strings
        else
            for _, entry in ipairs(entries) do
                if string.find(value, entry.search, 1, true) then
                    if safeSet(instance, prop, entry.replaceWith) then
                        changed = true
                    end
                    break
                end
            end
        end
    end

    return changed
end

-- Sweep only Workspace descendants, in batches to avoid frame hogging
local function sweepWorkspaceBatched(profile, batchSize, yieldTime)
    batchSize = batchSize or 200
    yieldTime = yieldTime or 0.03 -- seconds

    local descendants = workspace:GetDescendants()
    local replacedCount = 0
    local total = #descendants

    for i = 1, total, batchSize do
        local limit = math.min(i + batchSize - 1, total)
        for j = i, limit do
            local inst = descendants[j]
            if replaceOnInstance(inst, profile) then
                replacedCount = replacedCount + 1
            end
        end
        task.wait(yieldTime)
    end

    if replacedCount > 0 then
        print(('[AssetReplacer] Replaced %d assets (Workspace scan) for profile: %s'):format(replacedCount, profile.displayName))
    else
        print(('[AssetReplacer] No replacements needed (Workspace scan) for profile: %s'):format(profile.displayName))
    end
end

-- DescendantAdded queue + processor (debounced batching)
local addQueue = {}
local queueLock = false
local queueProcessor = nil

local function enqueueDescendant(desc)
    if not desc then return end
    table.insert(addQueue, desc)
end

local function startQueueProcessor(profile)
    if queueProcessor then return end
    queueProcessor = task.spawn(function()
        while isEnabled do
            if #addQueue == 0 then
                task.wait(0.12)
            else
                -- process up to N items per tick
                local toProcess = math.min(#addQueue, 50)
                for i = 1, toProcess do
                    local desc = table.remove(addQueue, 1)
                    if desc then
                        pcall(function()
                            replaceOnInstance(desc, profile)
                        end)
                    end
                end
                task.wait(0.05)
            end
        end
        queueProcessor = nil
    end)
end

local descAddedConn = nil
local isEnabled = false

local function enableReplacer()
    if isEnabled then return end
    isEnabled = true

    -- Start a batched sweep of Workspace only
    task.defer(function()
        sweepWorkspaceBatched(currentProfile, 200, 0.03)
    end)

    -- Queue new descendants for debounced processing
    descAddedConn = game.DescendantAdded:Connect(function(desc)
        enqueueDescendant(desc)
    end)

    startQueueProcessor(currentProfile)

    print("[AssetReplacer] Enabled for profile:", currentProfile.displayName)
end

local function disableReplacer()
    if not isEnabled then return end
    isEnabled = false
    if descAddedConn then
        descAddedConn:Disconnect()
        descAddedConn = nil
    end
    -- clear queue
    addQueue = {}
    print("[AssetReplacer] Disabled.")
end

local function setProfileByIndex(index)
    -- Only one profile; safe no-op setter
    currentProfileIndex = index
    currentProfile = profiles[profileKeys[currentProfileIndex]]
    if not currentProfile then
        currentProfileIndex = 1
        currentProfile = profiles[profileKeys[currentProfileIndex]]
    end

    print("[AssetReplacer] Profile set to:", currentProfile.displayName)

    if isEnabled then
        task.defer(function()
            sweepWorkspaceBatched(currentProfile, 200, 0.03)
        end)
    end
end

