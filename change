-- Order of profiles for UI cycling:
local profileKeys = {"purple_ttk", "white_portal", "purple_portal"}
local currentProfileIndex = 1
local currentProfile = profiles[profileKeys[currentProfileIndex]]

-- List of common properties to try replacing (safe pcall used)
local candidateProperties = {
    "MeshId",
    "Texture",
    "Image",
    "SoundId",
    "TextureId", -- sometimes used
    "BackImage",  -- UI-ish (if any)
}

-- Utility: try read a property safely
local function safeGet(instance, prop)
    local ok, val = pcall(function() return instance[prop] end)
    if ok then return val end
    return nil
end

-- Utility: try set a property safely
local function safeSet(instance, prop, value)
    pcall(function() instance[prop] = value end)
end

-- Replace function for a single instance, using provided mapping table (string->string)
local function replaceOnInstance(instance, mapping)
    if not instance then return end
    -- For each mapping (oldIdStr -> newIdStr)
    for oldIdStr, newIdStr in pairs(mapping) do
        local search = tostring(oldIdStr)
        local replaceWith = "rbxassetid://" .. tostring(newIdStr)

        -- If MeshPart / SpecialMesh, check MeshId specifically for slightly better performance
        if instance:IsA("MeshPart") or instance:IsA("SpecialMesh") then
            local meshVal = safeGet(instance, "MeshId")
            if type(meshVal) == "string" and string.find(meshVal, search, 1, true) then
                safeSet(instance, "MeshId", replaceWith)
                --print log
                print("[AssetReplacer] Replaced MeshId on", instance:GetFullName(), search, "->", replaceWith)
            end
        end

        -- Generic candidate properties
        for _, prop in ipairs(candidateProperties) do
            local val = safeGet(instance, prop)
            if type(val) == "string" and string.find(val, search, 1, true) then
                safeSet(instance, prop, replaceWith)
                print(("[AssetReplacer] Replaced %s.%s: %s -> %s"):format(instance:GetFullName(), prop, search, replaceWith))
            end
        end
    end
end

-- Process all existing descendants (initial sweep)
local function sweepAll(mapping)
    for _, inst in ipairs(game:GetDescendants()) do
        replaceOnInstance(inst, mapping)
    end
end

-- Connection for new descendants
local descAddedConn = nil

local isEnabled = false

local function enableReplacer()
    if isEnabled then return end
    isEnabled = true
    -- Replace existing
    sweepAll(currentProfile.mappings)
    -- Connect to future additions
    descAddedConn = game.DescendantAdded:Connect(function(desc)
        -- small delay may help objects initialize properties
        -- protect with pcall in case of weird objects
        pcall(function()
            replaceOnInstance(desc, currentProfile.mappings)
        end)
    end)
    print("[AssetReplacer] Enabled for profile:", currentProfile.displayName)
end

local function disableReplacer()
    if not isEnabled then return end
    isEnabled = false
    if descAddedConn then
        descAddedConn:Disconnect()
        descAddedConn = nil
    end
    print("[AssetReplacer] Disabled.")
end

-- Switch profile
local function setProfileByIndex(index)
    currentProfileIndex = index
    currentProfile = profiles[profileKeys[currentProfileIndex]]
    print("[AssetReplacer] Profile set to:", currentProfile.displayName)
    -- If enabled, re-run sweep with new mapping
    if isEnabled then
        sweepAll(currentProfile.mappings)
    end
end

