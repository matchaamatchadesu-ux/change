local function log(...)
    print("[TogglePortals]", ...)
end

local function httpRequest(opts)
    if syn and syn.request then
        local ok, res = pcall(function()
            return syn.request(opts)
        end)
        if ok then
            return res
        end
        return nil, tostring(res)
    end

    if http_request then
        local ok, res = pcall(function()
            return http_request(opts)
        end)
        if ok then
            return res
        end
        return nil, tostring(res)
    end

    if request then
        local ok, res = pcall(function()
            return request(opts)
        end)
        if ok then
            return res
        end
        return nil, tostring(res)
    end

    return nil, "no HTTP request function available"
end

local function readJsonFile(fileName)
    if not isfile(fileName) then
        return nil, "file not found: " .. fileName
    end

    local ok, body = pcall(function()
        return readfile(fileName)
    end)
    if not ok then
        return nil, "readfile failed: " .. tostring(body)
    end

    local ok2, json = pcall(function()
        return HttpService:JSONDecode(body)
    end)
    if not ok2 then
        return nil, "JSON decode failed: " .. tostring(json)
    end

    return json, nil
end

local function writeJsonFile(fileName, obj)
    local ok, encoded = pcall(function()
        return HttpService:JSONEncode(obj)
    end)
    if not ok then
        return false, "JSON encode failed: " .. tostring(encoded)
    end

    local ok2, err = pcall(function()
        writefile(fileName, encoded)
    end)
    if not ok2 then
        return false, "writefile failed: " .. tostring(err)
    end

    return true, nil
end

local function backupFile(fileName, content)
    local backupName = fileName .. ".bak"
    local ok, err = pcall(function()
        writefile(backupName, content)
    end)
    if not ok then
        return false, "backup failed: " .. tostring(err), backupName
    end
    return true, nil, backupName
end

local function fetchRemote(fileEntry)
    if not fileEntry.raw_url then
        return false, "no raw_url configured"
    end

    local res, err = httpRequest({
        Url = fileEntry.raw_url,
        Method = "GET",
        Headers = {
            ["Content-Type"] = "application/json"
        }
    })
    if not res then
        return false, err
    end

    if res.StatusCode and (res.StatusCode < 200 or res.StatusCode >= 300) then
        return false, "HTTP status: " .. tostring(res.StatusCode)
    end

    local ok, body = pcall(function()
        return res.Body
    end)
    if not ok then
        return false, "no response body"
    end

    local ok2, parsed = pcall(function()
        return HttpService:JSONDecode(body)
    end)
    if not ok2 then
        return false, "remote JSON parse failed: " .. tostring(parsed)
    end

    -- save local copy
    local ok3, err3 = pcall(function()
        writefile(fileEntry.name, body)
    end)
    if not ok3 then
        return false, "write remote JSON failed: " .. tostring(err3)
    end

    return true, "synced"
end

-- == rule logic ==
-- all true => false
-- all false => true
-- mixed => true
local function getTargetState(rules)
    if type(rules) ~= "table" then
        return true
    end

    local allTrue = true
    local anyTrue = false

    for _, rule in ipairs(rules) do
        if type(rule) == "table" then
            local enabled = rule.enabled ~= false
            if enabled then
                anyTrue = true
            else
                allTrue = false
            end
        end
    end

    if allTrue then
        return false
    end

    if not anyTrue then
        return true
    end

    return true
end

local function applyEnabledState(obj, enabled)
    if type(obj) ~= "table" or type(obj.replacement_rules) ~= "table" then
        return 0
    end

    local changed = 0
    for _, rule in ipairs(obj.replacement_rules) do
        if type(rule) == "table" then
            if rule.enabled ~= enabled then
                rule.enabled = enabled
                changed = changed + 1
            else
                rule.enabled = enabled
            end
        end
    end
    return changed
end

local function processFile(fileEntry, mode)
    -- mode: "set_on" / "set_off" / "toggle" / "preview" / "fetch_remote"

    if mode == "fetch_remote" then
        return fetchRemote(fileEntry)
    end

    local obj, err = readJsonFile(fileEntry.name)
    if not obj then
        return false, err
    end

    local originalRaw = HttpService:JSONEncode(obj)

    local target
    if mode == "set_on" then
        target = true
    elseif mode == "set_off" then
        target = false
    elseif mode == "toggle" then
        target = getTargetState(obj.replacement_rules)
    elseif mode == "preview" then
        target = getTargetState(obj.replacement_rules)
    else
        return false, "unknown mode"
    end

    local changed = applyEnabledState(obj, target)

    if mode == "preview" then
        print("[Preview]", fileEntry.name, "->", tostring(target), "changed:", changed)
        print(HttpService:JSONEncode(obj))
        return true, { target = target, changed = changed }
    end

    local okBak, bakErr, bakName = backupFile(fileEntry.name, originalRaw)
    if not okBak then
        return false, bakErr, bakName
    end

    local okWrite, writeErr = writeJsonFile(fileEntry.name, obj)
    if not okWrite then
        pcall(function()
            writefile(fileEntry.name, originalRaw)
        end)
        return false, writeErr
    end

    return true, { target = target, changed = changed, backup = bakName }
end

